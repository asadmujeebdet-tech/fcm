From 0f7cce4174b087ce3912a1b8477a05652c1f7201 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 29 Sep 2026 06:01:58 +0000
Subject: [PATCH 2/3] Stop exposing the dashboard password in the public login
 bundle

app/login/page.tsx is a client component that read NEXT_PUBLIC_PASSWORD and
prefilled the password field. NEXT_PUBLIC_* values are compiled into the
browser JavaScript and /login is public, so anyone could read the password
from .next/static/chunks/app/login/page-*.js (verified by building with the
variable set). The password is no longer prefilled.

If NEXT_PUBLIC_PASSWORD was ever set in production: remove it, redeploy and
change PASSWORD.
---
 app/login/page.tsx | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/app/login/page.tsx b/app/login/page.tsx
index 2cdfe56..95327ee 100644
--- a/app/login/page.tsx
+++ b/app/login/page.tsx
@@ -7,23 +7,24 @@ import { Input, Label } from "@/components/ui/Field";
 import { Button } from "@/components/ui/Button";
 
 const DEFAULT_EMAIL = process.env.NEXT_PUBLIC_EMAIL ?? "";
-const DEFAULT_PASSWORD = process.env.NEXT_PUBLIC_PASSWORD ?? "";
+// SECURITY: never prefill the password. NEXT_PUBLIC_* values are compiled into
+// the browser bundle, and /login is public, so anyone could read it.
 const WHATSAPP_ICON =
   "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcS90_MbyAab03ginKOTiuz932RRf0tJmH-J7KzSxk65CQ&s=10";
 
 export default function LoginPage() {
   return (
     <Suspense>
-      <LoginForm defaultEmail={DEFAULT_EMAIL} defaultPassword={DEFAULT_PASSWORD} />
+      <LoginForm defaultEmail={DEFAULT_EMAIL} />
     </Suspense>
   );
 }
 
-function LoginForm({ defaultEmail, defaultPassword }: { defaultEmail: string; defaultPassword: string }) {
+function LoginForm({ defaultEmail }: { defaultEmail: string }) {
   const router = useRouter();
   const searchParams = useSearchParams();
   const [email, setEmail] = useState(defaultEmail);
-  const [password, setPassword] = useState(defaultPassword);
+  const [password, setPassword] = useState("");
   const [showPassword, setShowPassword] = useState(false);
   const [loading, setLoading] = useState(false);
   const [error, setError] = useState<string | null>(null);
-- 
2.43.0


From c72919408f8a94e5592c616658244f8b4414d0cb Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 29 Sep 2026 06:01:58 +0000
Subject: [PATCH 3/3] Harden multi-app broadcasting and recovery

Database (new migration 20260929_harden_targets_and_recovery.sql, run it
BEFORE deploying this code):
- message_targets.app_id: ON DELETE CASCADE -> SET NULL, plus an app_name
  snapshot. Deleting an app used to silently delete its target rows from past
  broadcasts while messages.total_apps_targeted still counted them.
- claim_scheduled_messages() now also recovers stuck 'send now' messages
  (scheduled_at IS NULL); the old 'scheduled_at <= now()' guard was never
  true for them, so they stayed in 'sending' forever.
- schema.sql: add the user_id columns that its index and RLS policies already
  referenced, so a fresh install works.

API:
- POST /api/messages rejects the request if any selected app is missing
  instead of silently sending to a subset.
- Message and all target rows are inserted in one transaction; scheduling
  several times is all-or-nothing.
- maxDuration = 60 for the send-now request.
- Validate FCM topic names when saving an app.

Dispatchers (Next.js and Edge Function):
- Totals include targets resolved by an earlier run, so a resumed message no
  longer reports only its second half.
- A message with nothing processed is 'failed', not 'sent'.
- Heartbeat updated_at before each target in both dispatchers.
- Clear error for deleted apps and invalid topics.
- Edge Function accepts CRON_SECRET or FCM_CRON_SECRET and returns a JSON 500
  when neither is set.

UI:
- Compose no longer hangs on 'Sending...' when the server returns a non-JSON
  error page; shows a 'may be partially sent, check History' message.
- Wording: 'accepted by FCM' instead of 'delivered'.
- Compose says how many inactive apps are hidden from the picker.
- History shows each app's accepted / failed / pending state.

Also: README env vars corrected (EMAIL/PASSWORD are server-side; do not use
NEXT_PUBLIC_PASSWORD), migration order, and a troubleshooting section.
Tests: topic validation and final-status resolution.
---
 README.md                                     |  47 +++-
 app/(dashboard)/compose/ComposeClient.tsx     |  49 ++--
 app/(dashboard)/history/HistoryClient.tsx     |   2 +-
 app/api/apps/[id]/route.ts                    |   3 +-
 app/api/apps/route.ts                         |   5 +-
 app/api/messages/[id]/route.ts                |   2 +-
 app/api/messages/route.ts                     |  33 ++-
 lib/dispatch-message.ts                       | 176 ++++++++------
 lib/fcm-utils.ts                              |  17 ++
 .../functions/process-scheduled-fcm/index.ts  | 215 +++++++++++++-----
 .../20260929_harden_targets_and_recovery.sql  |  70 ++++++
 supabase/schema.sql                           |   7 +-
 tests/fcm-utils.test.mjs                      |  19 ++
 types/database.ts                             |   2 +-
 14 files changed, 482 insertions(+), 165 deletions(-)
 create mode 100644 supabase/migrations/20260929_harden_targets_and_recovery.sql

